# ==========================================
# 1. OS & System Files (맥 / 윈도우 시스템 파일)
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ==========================================
# 2. IDE & Editor Files (에디터 / 개발 도구)
# ==========================================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
.project
.settings/

# ==========================================
# 3. Logs & Temporary Files (로그 및 임시 파일)
# ==========================================
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ==========================================
# 4. Dependencies & Build Outputs (의존성 및 빌드)
# ==========================================
node_modules/
dist/
build/
.cache/
.tmp/
temp/

# ==========================================
# 5. Environment Variables & Credentials (환경변수)
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
